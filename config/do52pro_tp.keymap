#include <zephyr/dt-bindings/input/input-event-codes.h>

#define BASE 0
#define LOWER 1
#define UPPER 2
#define FUNC 3
#define CONFIG 4
#define MOUSE_KEYS 5
#define MOUSE_TP 6
#define MOUSE_TP_KEYS 7
#define MOUSE_TP_SET 8

#ifdef HAS_UROB

#define HAS_TRI_STATE
#define HAS_NUM_WORD

#endif

#define HAS_MOUSE_KEYS
#define HAS_MOUSE_TP
#define HAS_TRI_STATE

#include "includes/mouse_keys.dtsi"
#include "includes/mouse_tp.dtsi"
#include "includes/mouse_tp_badjeff_input_listener.dtsi"
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mt { flavor = "tap-preferred"; };

/ {
    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <19 20>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <31 32>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&out OUT_TOG  &kp N0           &kp N9   &kp N8     &kp N7  &kp N6       &kp N5        &kp N4    &kp N3     &kp N2  &kp N1        &kp ESCAPE
&kp BSPC      &kp P            &kp O    &kp I      &kp U   &kp Y        &kp T         &kp R     &kp E      &kp W   &kp Q         &kp TAB
&bt BT_SEL 1  &mt RSHIFT SEMI  &kp L    &kp K      &kp J   &kp H        &kp G         &kp F     &kp D      &kp S   &kp A         &kp LCTRL
&bt BT_CLR    &lt 7 FSLH       &kp DOT  &kp COMMA  &kp M   &kp N        &kp B         &kp V     &kp C      &kp X   &mt LSHIFT Z  &kp LSHFT
&mo 4         &mo 3                                &mo 5   &lt 1 SPACE  &mt LGUI RET  &kp LALT                     &kp LCTRL     &kp RET
              &mkp LCLK        &kp N4   &mkp RCLK  &kp N2  &mkp MCLK    &mkp MCLK     &kp N4    &mkp RCLK  &kp N2  &mkp LCLK
            >;
        };

        lower_layer {
            bindings = <
&kp F11          &kp F10    &kp F9     &kp F8     &kp F7    &kp F6     &kp F5     &kp F4          &kp F3           &kp F2        &kp F1     &kp GRAVE
&kp MINUS        &kp N0     &kp N9     &kp N8     &kp N7    &kp N6     &kp N3     &kp N4          &kp N3           &kp N2        &kp N1     &kp TAB
&kp APOS         &kp BSPC   &kp RIGHT  &kp UP     &kp DOWN  &kp LEFT   &kp G      &kp LS(RPAR)    &kp LS(QMARK)    &kp LS(LPAR)  &kp MINUS  &trans
&kp RIGHT_SHIFT  &kp SQT    &kp GRAVE  &kp BSLH   &kp RBKT  &kp LBKT   &kp TILDE  &kp LG(K_MUTE)  &kp C_VOLUME_UP  &kp C_VOL_DN  &kp EQUAL  &kp LSHFT
&trans           &trans                           &trans    &trans     &trans     &trans                                         &trans     &trans
                 &mkp LCLK  &kp N4     &mkp RCLK  &kp N2    &mkp MCLK  &mkp LCLK  &kp N4          &mkp RCLK        &kp N2        &mkp MCLK
            >;
        };

        upper_layer {
            bindings = <
&kp EQUAL  &kp MINUS          &none             &none           &none           &kp CARET  &kp PRCNT  &kp DLLR  &kp HASH   &kp AT  &kp EXCL   &kp GRAVE
&kp INS    &kp RIGHT_BRACKET  &kp LEFT_BRACKET  &kp UP_ARROW    &none           &none      &kp GRAVE  &kp RBRC  &kp LBRC   &none   &none      &kp TAB
&kp APOS   &none              &kp RIGHT_ARROW   &kp DOWN_ARROW  &kp LEFT_ARROW  &none      &none      &kp RPAR  &kp LPAR   &none   &none      &kp LSHFT
&none      &none              &none             &none           &none           &none      &none      &kp RPAR  &kp LPAR   &none   &none      &kp LSHFT
&kp RGUI   &kp LALT                                             &trans          &trans     &trans     &trans                       &none      &kp LCTRL
           &mkp LCLK          &kp N4            &mkp RCLK       &kp N2          &mkp MCLK  &mkp LCLK  &kp N4    &mkp RCLK  &kp N2  &mkp MCLK
            >;
        };

        func_layer {
            bindings = <
&kp DEL   &kp F10    &kp F9   &kp F6     &kp F7   &kp F6     &kp F5     &kp F4  &kp F3     &kp F2  &kp F1     &kp ESC
&none     &kp MB5    &kp MB2  &kp MB3    &kp MB1  &mkp MB4   &none      &none   &none      &none   &kp F11    &kp TAB
&none     &none      &none    &none      &none    &none      &none      &none   &none      &none   &none      &kp LSHFT
&none     &none      &none    &none      &none    &none      &none      &none   &none      &none   &none      &kp LSHFT
&kp RGUI  &kp LALT                       &none    &none      &none      &none                      &kp LGUI   &kp LCTRL
          &mkp LCLK  &kp N4   &mkp RCLK  &kp N2   &mkp MCLK  &mkp LCLK  &kp N4  &mkp RCLK  &kp N2  &mkp MCLK
            >;
        };

        config_layer {
            bindings = <
&bootloader       &bt BT_SEL 4       &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1    &bt BT_SEL 0  &bt BT_CLR_ALL  &bt BT_DISC 4  &bt BT_DISC 3  &bt BT_DISC 2  &bt BT_DISC 1  &bt BT_DISC 0
&none             &none              &none         &trans        &bt BT_NXT      &bt BT_PRV    &none           &none          &none          &none          &none          &none
&none             &none              &none         &none         &none           &none         &none           &none          &none          &none          &none          &none
&none             &none              &none         &none         &none           &none         &none           &none          &none          &none          &none          &none
&ext_power EP_ON  &ext_power EP_OFF                              &bt BT_CLR_ALL  &bt BT_CLR    &none           &none                                        &none          &none
                  &mkp LCLK          &kp N4        &mkp RCLK     &kp N2          &mkp MCLK     &mkp LCLK       &kp N4         &mkp RCLK      &kp N2         &mkp MCLK
            >;
        };

        MouseKeys_layer {
            bindings = <
&mms MS_TP_VALUE6_INCR  &mms MS_TP_PTS_THRESHOLD_INCR  &mms MS_TP_SENSITIVITY_INCR  &trans              &trans    &trans     &bt BT_CLR  &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1          &bt BT_SEL 0
&mms MS_TP_VALUE6_DECR  &mms MS_TP_PTS_THRESHOLD_DECR  &mms MS_TP_SENSITIVITY_DECR  &trans              &trans    &trans     &trans      &trans        &trans        &trans        &trans                &trans
&trans                  &trans                         &msc MOVE_X(10)              &msc (MOVE_Y(-10))  &mkp MB5  &mkp MB4   &trans      &trans        &trans        &trans        &kp C_BRIGHTNESS_INC  &kp C_BRIGHTNESS_DEC
&trans                  &trans                         &msc (MOVE_X(-10))           &msc MOVE_Y(10)     &trans    &trans     &trans      &kp C_PAUSE   &kp C_NEXT    &kp C_PREV    &trans                &trans
&trans                  &trans                                                                          &trans    &trans     &trans      &trans                                    &trans                &trans
                        &mkp LCLK                      &kp N4                       &mkp RCLK           &kp N2    &mkp MCLK  &mkp LCLK   &kp N4        &mkp RCLK     &kp N2        &mkp MCLK
            >;
        };

        MouseTP_layer {
            bindings = <
&mms MS_TP_VALUE6_INCR  &mms MS_TP_PTS_THRESHOLD_INCR  &mms MS_TP_SENSITIVITY_INCR  &trans              &trans     &trans     &trans     &trans  &trans     &trans  &trans     &trans
&mms MS_TP_VALUE6_DECR  &mms MS_TP_PTS_THRESHOLD_DECR  &mms MS_TP_SENSITIVITY_DECR  &trans              &trans     &trans     &trans     &trans  &trans     &trans  &trans     &trans
&trans                  &trans                         &msc MOVE_X(10)              &msc (MOVE_Y(-10))  &mkp MB5   &mkp MB4   &trans     &trans  &trans     &trans  &trans     &trans
&trans                  &trans                         &msc (MOVE_X(-10))           &msc MOVE_Y(10)     &trans     &trans     &trans     &trans  &trans     &trans  &trans     &trans
&trans                  &trans                                                                          &mkp RCLK  &mkp LCLK  &trans     &trans                     &trans     &trans
                        &mkp LCLK                      &kp N4                       &mkp RCLK           &kp N2     &mkp MCLK  &mkp LCLK  &kp N4  &mkp RCLK  &kp N2  &mkp MCLK
            >;
        };
    };
};
